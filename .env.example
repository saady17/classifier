# Copy to .env (chmod 600). Never commit real values.
CLASSIFIER_API_KEY=
# Job feeds that need free keys
USAJOBS_API_KEY=
USAJOBS_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Evaluation only (AI judges). The ranker never uses these.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Downloading evaluation resumes from a shared Drive folder
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Optional
# RATER_PASSWORD=          enables the /eval rating page
# CLASSIFIER_MODEL=off     rule-based scoring only
# FEATURE_WORKERS=1
