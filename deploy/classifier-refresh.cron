# Jobzhub classifier: refresh jobs from official feeds and analyze new/changed ones, daily 05:00 UTC.
SHELL=/bin/bash
0 5 * * * root cd /root/classifier && docker run --rm -m 5g --env-file /root/classifier/.env -v /root/classifier:/app -w /app classifier-dev sh -c 'python -m classifier.ingest && python -m classifier.features' > /root/classifier/data/refresh.log 2>&1
